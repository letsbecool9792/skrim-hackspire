{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // The harness runs in Node: it serves the fixtures and drives Chromium.
    // src/reading.ts, which the extension imports, uses no Node API.
    "types": ["node"]
  },
  "include": ["src"]
}
