{
  "name": "@skrim/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "compile": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "smoke": "node scripts/smoke.mjs",
    "probe": "node --env-file-if-exists=../../.env scripts/probe-models.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@skrim/schema": "workspace:*",
    "@skrim/shared": "workspace:*",
    "hono": "^4.13.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "0.28.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}