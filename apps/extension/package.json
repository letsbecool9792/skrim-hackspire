{
  "name": "@skrim/extension",
  "description": "On-device visual perception for browser agents. Nothing identifying leaves your machine.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "node --import tsx --test \"lib/**/*.test.ts\"",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@skrim/schema": "workspace:*",
    "@skrim/shared": "workspace:*",
    "@huggingface/transformers": "^4.2.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tesseract.js": "^7.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
