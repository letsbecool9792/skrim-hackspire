{
  "name": "@skrim/extension",
  "description": "On-device visual perception for browser agents. Nothing identifying leaves your machine.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "node --import tsx --test \"lib/**/*.test.ts\"",
    "demo:pii": "tsx scripts/pii-demo.ts",
    "test:agent": "tsx scripts/agent-check.ts",
    "eval:node": "tsx scripts/eval-node.ts",
    "study": "tsx scripts/provider-study.ts",
    "study:report": "tsx scripts/study-report.ts",
    "build:eval": "wxt build --mode eval",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@huggingface/tokenizers": "^0.1.3",
    "@huggingface/transformers": "^4.2.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@skrim/schema": "workspace:*",
    "@skrim/shared": "workspace:*",
    "lucide-react": "^1.49.0",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tesseract.js": "^7.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@skrim/eval": "workspace:*",
    "@types/chrome": "^0.2.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "onnxruntime-node": "1.24.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
