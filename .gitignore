# deps
node_modules/
.pnpm-store/

# builds
# NOTE: .gitignore has no trailing-comment syntax. A "# comment" after a
# pattern becomes part of the pattern. Keep comments on their own lines.
dist/
build/
# wxt build output
.output/
# wxt generated types
.wxt/
*.zip

# turbo
.turbo/

# env — never commit API keys
.env
.env.*
!.env.example

# python (scripts/)
.venv/
__pycache__/
*.pyc

# model weights — fetched by `pnpm models:fetch`, never committed
*.onnx
*.gguf
*.pt
*.safetensors
*.traineddata
*.tflite
apps/extension/public/models/

# Models we export ourselves (the icon detector, 81 MB) are exported by
# fetch-models.mjs into scripts/artifacts/ and copied from there. They are
# ignored too (*.onnx above): big files do not belong in git history.

# editor / os
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# eval output
packages/eval/results/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# Vercel build output (apps/server/scripts/build-vercel.mjs) and CLI state
.vercel/
