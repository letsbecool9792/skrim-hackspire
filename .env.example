# ---------------------------------------------------------------------------
# Copy this file to .env at the REPO ROOT (not apps/server/) and fill in the
# blanks. One .env for the whole monorepo - the server loads it via
# --env-file-if-exists=../../.env, and the Vite apps read it through envDir.
#
#   cp .env.example .env
#
# .env is gitignored. .env.example is committed. Never put a real key here.
#
# Three providers are wired: Groq (the default, hosted Qwen), Ollama for the
# offline/air-gap demo and for when Groq's daily limit runs out, and NVIDIA,
# which has no daily cap. Cloudflare Workers AI and OpenRouter are documented
# as fallbacks in CLAUDE.md - do not add them here until they are actually
# needed.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
PORT=3000

# Which provider the planner routes through: groq | ollama | nvidia
# All are OpenAI-compatible, so this only swaps a baseURL + model.
MODEL_PROVIDER=groq


# --- Groq - hosted Qwen, the default ----------------------------------------
# Free, no credit card: https://console.groq.com/keys. Qwen is not on NVIDIA,
# and Groq is the free host with it. It did all 42 runs of the provider study
# (docs/provider-study.md). Free-tier limits for this model: 30 requests and
# 8,000 tokens a minute, 1,000 requests and 200,000 tokens a day. One agent
# step costs about 700 tokens plus ~20 per element on the page, so 4-5 steps
# a minute; the server waits out the short pauses. When the day runs out,
# switch to MODEL_PROVIDER=ollama.
# EVERY TEAMMATE NEEDS THEIR OWN KEY. The limits are per account, so six
# people sharing one key will throttle each other during crunch.
#
# This is the only value you actually have to fill in.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
# Qwen 3.x thinks before answering unless this is "none". Other models may
# need low | medium | high instead.
GROQ_REASONING_EFFORT=none


# --- Ollama - air-gap demo + offline dev -----------------------------------
# No key. Requires `ollama pull qwen3-vl:4b-instruct` locally (3.3 GB).
# 4B is the ceiling on a 6 GB card; see CLAUDE.md "Hardware reality".
# Use the -instruct tag: plain qwen3-vl:4b is the thinking build, which took
# 5-40 s a step against ~0.5 s, and sometimes returned nothing but reasoning.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3-vl:4b-instruct


# --- NVIDIA Build - no daily cap -------------------------------------------
# Free, no credit card, ~40 req/min. Sign up: https://build.nvidia.com
# Only needed with MODEL_PROVIDER=nvidia.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# A model being listed on build.nvidia.com does NOT mean your account can call
# it. Checked on a free account: no Qwen models exist there; Gemma 3
# and Phi-3 Vision return "not found for account"; Llama 3.2 90B Vision never
# answered within 60 s. Llama 3.2 11B Vision answers but never finishes a task
# (0 of 42 in the provider study); nvidia/nemotron-3-super-120b-a12b did 37 of
# 42. Before changing this, run `pnpm smoke:server` against the new value - a
# wrong slug only fails at request time, not at startup.
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct


# --- Clients ---------------------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to browser code.
# Never prefix a secret with VITE_ - it ends up in the bundle.
VITE_SERVER_URL=http://localhost:3000
