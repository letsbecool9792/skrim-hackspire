# ---------------------------------------------------------------------------
# Copy this file to .env at the REPO ROOT (not apps/server/) and fill in the
# blanks. One .env for the whole monorepo - the server loads it via
# --env-file-if-exists=../../.env, and the Vite apps read it through envDir.
#
#   cp .env.example .env
#
# .env is gitignored. .env.example is committed. Never put a real key here.
#
# Only two providers are wired right now: NVIDIA for development, Ollama for
# the offline/air-gap demo. Cloudflare Workers AI and OpenRouter are documented
# as fallbacks in CLAUDE.md and will be added if NVIDIA's limits become a
# problem - do not add them here until they are actually needed.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
PORT=3000

# Which provider the planner routes through: nvidia | ollama
# Both are OpenAI-compatible, so this only swaps a baseURL + model.
MODEL_PROVIDER=nvidia


# --- NVIDIA Build - dev default --------------------------------------------
# Free, no credit card, ~40 req/min. Sign up: https://build.nvidia.com
# EVERY TEAMMATE NEEDS THEIR OWN KEY. The rate limit is per account, so six
# people sharing one key will throttle each other during crunch.
#
# This is the only value you actually have to fill in.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# A model being listed on build.nvidia.com does NOT mean your account can call
# it. Checked on a free account: no Qwen models exist there; Gemma 3
# and Phi-3 Vision return "not found for account"; Llama 3.2 90B Vision never
# answered within 60 s. Llama 3.2 11B Vision works. Before changing this, run
# `pnpm smoke:server` against the new value - a wrong slug only fails at
# request time, not at startup.
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct


# --- Ollama - air-gap demo + offline dev -----------------------------------
# No key. Requires `ollama pull qwen3-vl:4b` locally (3.3 GB).
# 4B is the ceiling on a 6 GB card; see CLAUDE.md "Hardware reality".
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3-vl:4b


# --- Clients ---------------------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to browser code.
# Never prefix a secret with VITE_ - it ends up in the bundle.
VITE_SERVER_URL=http://localhost:3000
