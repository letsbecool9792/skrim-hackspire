# ---------------------------------------------------------------------------
# Copy this file to .env at the REPO ROOT (not apps/server/) and fill in the
# blanks. One .env for the whole monorepo - the server loads it via
# --env-file-if-exists=../../.env, and the Vite apps read it through envDir.
#
#   cp .env.example .env
#
# .env is gitignored. .env.example is committed. Never put a real key here.
#
# Three providers are wired: Groq (the default, hosted Qwen), Ollama for the
# offline/air-gap demo and for when Groq's daily limit runs out, and NVIDIA,
# which has no daily cap. Cloudflare Workers AI and OpenRouter are documented
# as fallbacks in CLAUDE.md - do not add them here until they are actually
# needed.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
PORT=3000

# Which provider the planner routes through: groq | cerebras | nvidia | ollama
# All are OpenAI-compatible, so this only swaps a baseURL + model.
MODEL_PROVIDER=groq
# Who plans a step when the one before says to come back later, in order,
# comma-separated: free tiers cap tokens a minute and a day, each its own.
# For example nvidia (needs its key), or ollama if you have it.
# A provider with another after it hands over any pause longer than 5 s.
# Empty: that step fails with the rate-limit message.
FALLBACK_PROVIDER=


# --- Groq - hosted Qwen, the default ----------------------------------------
# Free, no credit card: https://console.groq.com/keys. Qwen is not on NVIDIA,
# and Groq is the free host with it. It did all 42 runs of the provider study
# (docs/provider-study.md). Free-tier limits for this model: 30 requests and
# 8,000 tokens a minute, 1,000 requests and 200,000 tokens a day. One agent
# step costs about 700 tokens plus ~20 per element on the page, so 4-5 steps
# a minute; the server waits out the short pauses. When the day runs out,
# FALLBACK_PROVIDER above takes over.
# EVERY TEAMMATE NEEDS THEIR OWN KEY. The limits are per account, so six
# people sharing one key will throttle each other during crunch.
#
# This is the only value you actually have to fill in.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
# Qwen 3.x thinks before answering unless this is "none". Other models may
# need low | medium | high instead.
GROQ_REASONING_EFFORT=none


# --- Ollama - air-gap demo + offline dev -----------------------------------
# No key. Requires `ollama pull qwen3:4b-instruct-2507-q4_K_M` locally (2.5 GB),
# then `pnpm ollama:setup`, which makes "skrim-planner": that text model with a
# 12k context (scripts/ollama/Modelfile). The planner is sent text only, so a
# text model beats the vision one we used before (Qwen3-VL 4B, still available
# as "skrim-planner-vl" via `pnpm ollama:setup:vl` to compare). Ollama's
# default context is 4k and cuts a real page's request from the front.
# Use an instruct build: thinking builds take 5-40 s a step against ~0.5 s.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=skrim-planner


# --- Cerebras - the same Qwen 3.8 27B, its own allowance ------------------
# NOT free without a card: API access starts only once a payment method is
# added (checked 2026-11-15), so it is outside our rules. Wired in case a
# team member has an account anyway. Only needed with
# MODEL_PROVIDER=cerebras or cerebras in FALLBACK_PROVIDER.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3.8-27b


# --- NVIDIA Build - no daily cap -------------------------------------------
# Free, no credit card, ~40 req/min. Sign up: https://build.nvidia.com
# Only needed with MODEL_PROVIDER=nvidia or nvidia in FALLBACK_PROVIDER.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# A model being listed on build.nvidia.com does NOT mean your account can call
# it, or that it still will: by 2026-11-15 nemotron-3-super-120b-a12b (37 of 42
# in the provider study) answered 404 "not found for account". Of the models
# that answered, nemotron-3.5-lightning-30b-a3b did 6 of 8 agent tasks, about
# 11 s a step. Before changing this, call the model once with your key: a wrong
# slug only fails at request time, not at startup.
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Nemotron thinks before answering. off makes it ~25x faster a step, but in a
# test it then went in circles on every page. Leave unset.
# NVIDIA_THINKING=off


# --- Clients ---------------------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to browser code.
# Never prefix a secret with VITE_ - it ends up in the bundle.
VITE_SERVER_URL=http://localhost:3000
